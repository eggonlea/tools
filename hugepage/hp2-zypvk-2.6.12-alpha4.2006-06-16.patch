+static int mhugepage_fixup(struct vm_area_struct * vma, unsigned long address)
+{
+	int ret = 0;
+	unsigned long start, end;
+	struct mm_struct * mm;
+	HUGE_PAGE_DEBUG_EX(("0x%08x[%8s]: fixup addr=0x%08x, vma=(0x%08x, 0x%08x)\n", 
+		current->pid, current->comm, address, vma->vm_start, vma->vm_end))
+	
+	start = address & HUGE_PAGE_MASK;
+	end = start + HUGE_PAGE_SIZE;
+	mm = vma->vm_mm;
+
+	if (start != vma->vm_start) {
+		if (split_vma(mm, vma, start, 1)) {
+			ret = -EAGAIN;
+			HUGE_PAGE_DEBUG_EX(("Error in mhugepage_fixup: start=0x%08x, end=0x%08x\n", 
+				start, end))
+			goto out;
+		}
+	}
+
+	if (end != vma->vm_end) {
+		if (split_vma(mm, vma, end, 0)) {
+			ret = -EAGAIN;
+			HUGE_PAGE_DEBUG_EX(("Error in mhugepage_fixup: start=0x%08x, end=0x%08x\n", 
+				start, end))
+			goto out;
+		}
+	}
+
+	vma->vm_flags &= (~VM_HUGEPAGE) & (~VM_RESERVED);
+
+out:
+	return ret;
+}
