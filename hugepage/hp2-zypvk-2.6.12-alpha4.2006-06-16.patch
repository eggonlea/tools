 EXPORT_SYMBOL(__alloc_pages);
 
+#ifdef HUGE_PAGE_MEMORY_MANAGEMENT
+/*
+ * Similar with alloc_pages().
+ * Ensure pages HUGE_PAGE_ALIGN'ed.
+ */
+struct page * fastcall __alloc_huge_page(unsigned int gfp)
+{
+	int i;
+	struct page *page, *end, *free, *aligned_page;
+	dma_addr_t dma_addr, aligned_dma;
+	unsigned long aligned_off;
+
+	page = alloc_pages(gfp, HUGE_PAGE_ORDER);
+	if (!page)
+		goto no_page;
+
+	dma_addr = page_to_phys(page);
+
+	if (dma_addr & ~HUGE_PAGE_MASK) {	// realloc memory
+		__free_pages(page, HUGE_PAGE_ORDER);
+		/* Allocate aditional 64KB memory, in order 
+		 * to align memory to 64KB boundary. 
+		 * Unused pages will be freed */
+		page = alloc_pages(gfp, HUGE_PAGE_ORDER + 1);
+		if (!page)
+			goto no_page;
+
+		dma_addr = page_to_phys(page);
+
+		aligned_dma = HUGE_PAGE_ALIGN(dma_addr);
+		aligned_off = aligned_dma - dma_addr;
+
+		/* Free unused 64KB pages, 2 parts in total */
+		aligned_page = virt_to_page(__va(dma_addr + aligned_off)); 
+
+		free = aligned_page + (HUGE_PAGE_SIZE >> PAGE_SHIFT);
+		end  = page + (1 << (HUGE_PAGE_ORDER + 1));
+
+		for (; page < aligned_page; page++) {
+			set_page_count(page, 1);
+			__free_page(page);
+		}
+		for (; page < free; page++) {
+			set_page_count(page, 1);
+		}
+		for (; page < end; page++) {
+			set_page_count(page, 1);
+			__free_page(page);
+		}
+	}
+	else {
+		aligned_page = page;
+		for(i=HUGE_PAGE_SIZE/PAGE_SIZE; i>0; i--) {
+			set_page_count(page, 1);
+			page ++;
+		}
+	}
+	
+	return aligned_page;
+
+no_page:
+	HUGE_PAGE_DEBUG_EX(("alloc_huge_page: no_page.\n"))
+	return NULL;
+}
+
+EXPORT_SYMBOL(__alloc_huge_page);
+#endif
