+	if (!TestSetPageLocked(old_page)) {
+		int reuse = can_share_swap_page(old_page);
+		unlock_page(old_page);
+		if (reuse) {
+			HUGE_PAGE_DEBUG_EX(("\tReuse\n"))
+			for(i=HUGE_PAGE_SIZE/PAGE_SIZE; i>0; i--) {
+				pfn = pte_pfn(*page_table);
+				flush_cache_page(vma, address, pfn);
+				entry = pte_mkhuge(maybe_mkwrite(pte_mkyoung(pte_mkdirty(*page_table)), 
+					vma));
+				ptep_set_access_flags(vma, address, page_table, entry, 1);
+				update_mmu_cache(vma, address, entry);
+				lazy_mmu_prot_update(entry);
+				pte_unmap(page_table);
+				
+				page_table ++;
+				address += PAGE_SIZE;
+			}
+			spin_unlock(&mm->page_table_lock);
+			return VM_FAULT_MINOR;
+		}
+	}
+#endif
+	huge_pte_unmap(huge_pte);	
+	
+	/*
+	 * Ok, we need to copy. Oh, well..
+	 */
+	get_huge_page(old_page);
+	spin_unlock(&mm->page_table_lock);
+
+	if (unlikely(anon_vma_prepare(vma)))
+		goto no_new_page;
+
+#ifdef HUGE_PAGE_COW
+	/* Try huge page first */
+	new_page = alloc_huge_page_vma(GFP_HIGHUSER | __GFP_NOWARN, vma, address);
+	//new_page = alloc_huge_page_vma(GFP_HIGHUSER, vma, address);
+	if (new_page) {
+		/* Init huge page */
+		address = huge_address;
+		src_page = old_page;
+		dst_page = new_page;
+		for(i=0; i<HUGE_PAGE_SIZE/PAGE_SIZE; i++) {
+			//set_page_count(dst_page, 1);
+			copy_user_highpage(dst_page, src_page, address);
+
+			src_page ++;
+			dst_page ++;
+			address += PAGE_SIZE;
+		}
+	} else {
+		HUGE_PAGE_DEBUG_EX(("Warn: do_wp_huge_page failed: addr=0x%08x\n", address))
+#endif
+		/* Disable current huge-page mapping if no huge-page memory temporarily */
+		if(mhugepage_fixup(vma, address))
+			goto no_new_page;
+
+		/* Try small pages then */
+		src_page = old_page;
+		for(i=0; i<HUGE_PAGE_SIZE/PAGE_SIZE; i++) {
+			new_pages[i] = alloc_page_vma(GFP_HIGHUSER, vma, address);
+			if (!(new_pages[i])) {
+				/* Free the allocated pages */
+				for(i--; i>0; i--)
+					page_cache_release(new_pages[i]);
+				goto no_new_page;
+			}
+			copy_user_highpage(new_pages[i], src_page, address);
+			src_page ++;
+			address += PAGE_SIZE;
+		}
+#ifdef HUGE_PAGE_COW
+	}
+#endif
+	
+	/*
+	 * Re-check the pte - we dropped the lock
+	 */
+	pte_is_ok = 0;
+	address = huge_address;
+	src_page = old_page;
+	page_table = huge_pte;
+	spin_lock(&mm->page_table_lock);
+
+	if(new_page) {
+		if (likely(pte_same(*page_table, pte))) {
+			dst_page = new_page;
+			for(i=0; i<HUGE_PAGE_SIZE/PAGE_SIZE; i++) {
+				if (PageAnon(src_page))
+					dec_mm_counter(mm, anon_rss);
+				page_remove_rmap(src_page);
+				//SetPageReferenced(dst_page);
+				pfn = pte_pfn(*page_table);
+				flush_cache_page(vma, address, pfn);
+				break_cow(vma, dst_page, address, page_table);
+				page_add_anon_rmap(dst_page, vma, address);
+				src_page ++;
+				dst_page ++;
+				page_table ++;
+				address += PAGE_SIZE;
+			}
+			pte_is_ok = 1;
+		}
+	} else {
+		if (likely(pte_same(*page_table, pte))) {
+			for(i=0; i<HUGE_PAGE_SIZE/PAGE_SIZE; i++) {
+				dst_page = new_pages[i];
+				if (PageAnon(src_page))
+					dec_mm_counter(mm, anon_rss);
+				page_remove_rmap(src_page);
+				//SetPageReferenced(dst_page);
+				pfn = pte_pfn(*page_table);
+				flush_cache_page(vma, address, pfn);
+				break_cow(vma, dst_page, address, page_table);
+				lru_cache_add_active(dst_page);
+				page_add_anon_rmap(dst_page, vma, address);
+				src_page ++;
+				page_table ++;
+				address += PAGE_SIZE;
+			}
+			pte_is_ok = 1;
+		}
+	}
+	huge_pte_unmap(huge_pte);
+	if(pte_is_ok)
+		put_huge_page(old_page);
+	else {
+		if(new_page)
+			put_huge_page(new_page);
+		else {
+			for(i=0; i<HUGE_PAGE_SIZE/PAGE_SIZE; i++)
+				page_cache_release(new_pages[i]);
+		}
+	}
+	put_huge_page(old_page);
+	spin_unlock(&mm->page_table_lock);
+	return VM_FAULT_MINOR;
+
+no_new_page:
+	HUGE_PAGE_DEBUG_EX(("Error: no_new_page on do_wp_huge_page\n"))
+	put_huge_page(old_page);
+	return VM_FAULT_OOM;
+}
