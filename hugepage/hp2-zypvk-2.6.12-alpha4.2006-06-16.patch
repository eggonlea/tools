diff -urbN --exclude-from=/home/lli5/script/kernel-dontdiff linux.noL2/arch/arm/mm/consistent.c linux.noL2.hp2/arch/arm/mm/consistent.c
--- linux.noL2/arch/arm/mm/consistent.c	2006-05-30 10:24:11.000000000 +0800
+++ linux.noL2.hp2/arch/arm/mm/consistent.c	2006-06-16 09:00:32.000000000 +0800
@@ -75,6 +75,52 @@
 };
 
 static struct vm_region *
+vm_region_alloc_huge(struct vm_region *head, size_t size, int gfp)
+{
+	unsigned long addr, end;
+	unsigned long flags;
+	struct vm_region *c, *new;
+
+	size = HUGE_PAGE_ALIGN(size);
+	addr = HUGE_PAGE_ALIGN(head->vm_start);
+	end = head->vm_end - size;
+ 
+	new = kmalloc(sizeof(struct vm_region), gfp);
+	if (!new)
+		goto out;
+
+	spin_lock_irqsave(&consistent_lock, flags);
+
+	list_for_each_entry(c, &head->vm_list, vm_list) {
+		if ((addr + size) < addr)
+			goto nospc;
+		if ((addr + size) <= c->vm_start)
+			goto found;
+		addr = HUGE_PAGE_ALIGN(c->vm_end);
+		if (addr > end)
+			goto nospc;
+	}
+
+ found:
+	/*
+	 * Insert this entry _before_ the one we found.
+	 */
+	list_add_tail(&new->vm_list, &c->vm_list);
+	new->vm_start = addr;
+	new->vm_end = addr + size;
+	HUGE_PAGE_DEBUG_EX(("vm_region_alloc_huge: 0x%08x -> 0x%08x\n", addr, addr+size))
+
+	spin_unlock_irqrestore(&consistent_lock, flags);
+	return new;
+
+ nospc:
+	spin_unlock_irqrestore(&consistent_lock, flags);
+	kfree(new);
+ out:
+	return NULL;
+}
+
+static struct vm_region *
 vm_region_alloc(struct vm_region *head, size_t size, int gfp)
 {
 	unsigned long addr = head->vm_start, end = head->vm_end - size;
@@ -247,6 +293,182 @@
 }
 
 /*
+ * Similar with __dma_alloc.
+ * These functions ensure the (*handle) of dma to be HUGE_PAGE_ALIGN'ed.
+ * The "size" is better to be HUGE_PAGE_ALIGN'ed if enabling the flag of
+ * L_PTE_HUGE when calling set_pte() , or the UNUSED virtual memory block 
+ * should NOT be used any longer (to avoid potential security issues)!
+ */
+static void *
+__dma_alloc_huge(struct device *dev, size_t size, dma_addr_t *handle, int gfp,
+	    pgprot_t prot)
+{
+	struct page *page, *end, *free, *aligned_page;
+	unsigned long order, size2;
+	dma_addr_t dma_addr, aligned_dma;
+	unsigned long aligned_off;
+	struct vm_region *c;
+	u64 mask = ISA_DMA_THRESHOLD, limit;
+
+	if (!consistent_pte) {
+		printk(KERN_ERR "%s: not initialised\n", __func__);
+		dump_stack();
+		return NULL;
+	}
+
+	if (dev) {
+		mask = dev->coherent_dma_mask;
+
+		/*
+		 * Sanity check the DMA mask - it must be non-zero, and
+		 * must be able to be satisfied by a DMA allocation.
+		 */
+		if (mask == 0) {
+			dev_warn(dev, "coherent DMA mask is unset\n");
+			goto no_page;
+		}
+
+		if ((~mask) & ISA_DMA_THRESHOLD) {
+			dev_warn(dev, "coherent DMA mask %#llx is smaller "
+				 "than system GFP_DMA mask %#llx\n",
+				 mask, (unsigned long long)ISA_DMA_THRESHOLD);
+			goto no_page;
+		}
+	}
+
+	/*
+	 * Sanity check the allocation size.
+	 */
+	size = PAGE_ALIGN(size);
+	limit = (mask + 1) & ~mask;
+	if ((limit && size >= limit) ||
+	    size >= (CONSISTENT_END - CONSISTENT_BASE)) {
+		printk(KERN_WARNING "coherent allocation too big "
+		       "(requested %#x mask %#llx)\n", size, mask);
+		goto no_page;
+	}
+
+	order = get_order(size);
+
+	if (mask != 0xffffffff)
+		gfp |= GFP_DMA;
+
+	page = alloc_pages(gfp, order);
+	if (!page)
+		goto no_page;
+
+	dma_addr = page_to_dma(dev, page);
+
+	if (dma_addr & ~HUGE_PAGE_MASK) {	// realloc memory
+		__free_pages(page, order);
+		/* Allocate aditional 64KB memory, in order 
+		 * to align memory to 64KB boundary. 
+		 * Unused pages will be freed */
+		size2 = size + HUGE_PAGE_SIZE;
+		order = get_order(size2);
+
+		page = alloc_pages(gfp, order);
+		if (!page)
+			goto no_page;
+
+		dma_addr = page_to_dma(dev, page);
+
+		aligned_dma = HUGE_PAGE_ALIGN(dma_addr);
+		aligned_off = aligned_dma - dma_addr;
+
+		/* Get the HUGE_PAGE_ALIGN'ed page */
+		aligned_page = virt_to_page(__bus_to_virt(dma_addr + aligned_off)); 
+	}
+	else {
+		aligned_page = page;
+		aligned_dma = dma_addr;
+	}
+	
+	/*
+	 * Invalidate any data that might be lurking in the
+	 * kernel direct-mapped region for device DMA.
+	 */
+	{
+		unsigned long kaddr = (unsigned long)page_address(aligned_page);
+		memset(page_address(aligned_page), 0, size);
+		dmac_flush_range(kaddr, kaddr + size);
+	}
+
+	/*
+	 * Allocate a virtual address in the consistent mapping region.
+	 */
+	c = vm_region_alloc_huge(&consistent_head, size,
+			    gfp & ~(__GFP_DMA | __GFP_HIGHMEM));
+	HUGE_PAGE_DEBUG_EX(("vm_region_alloc_huge return: 0x%08x -> 0x%08x\n", 
+		c->vm_start, c->vm_end))
+	if (c) {
+		pte_t *pte = consistent_pte + CONSISTENT_OFFSET(c->vm_start);
+
+		c->vm_pages = aligned_page;
+
+		/*
+		 * Set the "dma handle"
+		 */
+		*handle = aligned_dma;
+
+		/* Free unused 64KB pages, 2 parts in total */
+		free = aligned_page + (size >> PAGE_SHIFT);
+		end  = page + (1 << order);
+		while(page < aligned_page) {
+			set_page_count(page, 1);
+			__free_page(page);
+			page++;
+		}
+		while(page < free) {
+			BUG_ON(!pte_none(*pte));
+			
+			set_page_count(page, 1);
+			SetPageReserved(page);
+			set_pte(pte, pte_mkhuge(mk_pte(page, prot)));
+			page++;
+			pte++;
+		}	
+		while(page < end) {
+			set_page_count(page, 1);
+			__free_page(page);
+			page++;
+		}
+
+		HUGE_PAGE_DEBUG_EX(("allocate huge page: 0x%08x\n", aligned_page))
+		return (void *)c->vm_start;
+	}
+
+	if (page)
+		__free_pages(page, order);
+ no_page:
+	*handle = ~0;
+	return NULL;
+}
+
+/*
+ * Similar with dma_alloc_coherent() & dma_alloc_writecombine().
+ * These functions ensure the (*handle) of dma to be HUGE_PAGE_ALIGN'ed.
+ * The "size" is better to be HUGE_PAGE_ALIGN'ed if enabling the flag of
+ * L_PTE_HUGE when calling set_pte() , or the UNUSED virtual memory block 
+ * should NOT be used any longer (to avoid potential security issues)!
+ */
+void *
+dma_alloc_huge_coherent(struct device *dev, size_t size, dma_addr_t *handle, int gfp)
+{
+	return __dma_alloc_huge(dev, size, handle, gfp,
+			   pgprot_noncached(pgprot_kernel));
+}
+EXPORT_SYMBOL(dma_alloc_huge_coherent);
+
+void *
+dma_alloc_huge_writecombine(struct device *dev, size_t size, dma_addr_t *handle, int gfp)
+{
+	return __dma_alloc_huge(dev, size, handle, gfp,
+			   pgprot_writecombine(pgprot_kernel));
+}
+EXPORT_SYMBOL(dma_alloc_huge_writecombine);
+
+/*
  * Allocate DMA-coherent memory space and return both the kernel remapped
  * virtual and bus address for that space.
  */
diff -urbN --exclude-from=/home/lli5/script/kernel-dontdiff linux.noL2/arch/arm/mm/mmap.c linux.noL2.hp2/arch/arm/mm/mmap.c
--- linux.noL2/arch/arm/mm/mmap.c	2006-05-30 10:24:11.000000000 +0800
+++ linux.noL2.hp2/arch/arm/mm/mmap.c	2006-06-16 19:45:22.828802616 +0800
@@ -9,6 +9,58 @@
 
 #include <asm/system.h>
 
+#ifdef HUGE_PAGE_MEMORY_MANAGEMENT
+unsigned long
+arch_get_unmapped_huge_area(struct file *filp, unsigned long addr,
+		unsigned long len, unsigned long pgoff, unsigned long flags)
+{
+	struct mm_struct *mm = current->mm;
+	struct vm_area_struct *vma;
+	unsigned long start_addr;
+	
+	len = HUGE_PAGE_ALIGN(len);
+
+	if (len > TASK_SIZE)
+		return -ENOMEM;
+
+	if (addr) {
+		addr = HUGE_PAGE_ALIGN(addr);
+
+		vma = find_vma(mm, addr);
+		if (TASK_SIZE - len >= addr &&
+		    (!vma || addr + len <= vma->vm_start))
+			return addr;
+	}
+	start_addr = addr = mm->free_area_cache;
+
+full_search:
+	addr = HUGE_PAGE_ALIGN(addr);
+
+	for (vma = find_vma(mm, addr); ; vma = vma->vm_next) {
+		/* At this point:  (!vma || addr < vma->vm_end). */
+		if (TASK_SIZE - len < addr) {
+			/*
+			 * Start a new search - just in case we missed
+			 * some holes.
+			 */
+			if (start_addr != TASK_UNMAPPED_BASE) {
+				start_addr = addr = TASK_UNMAPPED_BASE;
+				goto full_search;
+			}
+			return -ENOMEM;
+		}
+		if (!vma || addr + len <= vma->vm_start) {
+			/*
+			 * Remember the place where we stopped the search:
+			 */
+			mm->free_area_cache = addr + len;
+			return addr;
+		}
+		addr = HUGE_PAGE_ALIGN(vma->vm_end);
+	}
+}
+#endif
+
 #define COLOUR_ALIGN(addr,pgoff)		\
 	((((addr)+SHMLBA-1)&~(SHMLBA-1)) +	\
 	 (((pgoff)<<PAGE_SHIFT) & (SHMLBA-1)))
