+/*
+ * Similar with do_wp_page().
+ * Huge page mapping support. 
+ */
+static int do_wp_huge_page(struct mm_struct *mm, struct vm_area_struct * vma,
+	unsigned long address, pte_t *page_table, pmd_t *pmd, pte_t pte)
+{
+	int i;
+	int pte_is_ok;
+#ifdef HUGE_PAGE_COW_REUSE
+	pte_t entry;
+#endif
+	pte_t * huge_pte;
+	unsigned long huge_address;
+	
+	struct page *old_page;
+	struct page *new_page = NULL;
+	struct page *src_page, *dst_page;
+	struct page * new_pages[HUGE_PAGE_SIZE/PAGE_SIZE];
+	unsigned long pfn;
+	
+	HUGE_PAGE_DEBUG_EX(("0x%08x[%8s]: wp_huge: addr=0x%08x\n", 
+		current->pid, current->comm, address))
+
+	if(adjust_huge_pte_addr(pmd, &page_table, &address))
+		return VM_FAULT_OOM;
+	
+	huge_address = address;
+	huge_pte = page_table;
+	pte = *page_table;
+	
+	pfn = pte_pfn(pte);
+
+	if (unlikely(!pfn_valid(pfn))) {
+		/* XIP memory will not drop here, which don't have HUGE_PAGE flag set */
+
+		/*
+		 * This should really halt the system so it can be debugged or
+		 * at least the kernel stops what it's doing before it corrupts
+		 * data, but for the moment just pretend this is OOM.
+		 */
+		huge_pte_unmap(huge_pte);
+		printk(KERN_ERR "do_wp_page: bogus page at address %08lx\n",
