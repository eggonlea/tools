+#ifdef HUGE_PAGE_MEMORY_MANAGEMENT
+/*
+ * Similar with do_anonymous_page().
+ * Huge page mapping support. 
+ */
+static int
+do_anonymous_huge_page(struct mm_struct *mm, struct vm_area_struct *vma,
+		pte_t *page_table, pmd_t *pmd, int write_access,
+		unsigned long addr)
+{
+	int i;
+	pte_t entry;
+	struct page *page;
+	struct page *huge_page;
+	unsigned long huge_addr;
+	
+	HUGE_PAGE_DEBUG_EX(("0x%08x[%8s]: anony_huge: addr=0x%08x\n", 
+		current->pid, current->comm, addr))
+	if(adjust_huge_pte_addr(pmd, &page_table, &addr))
+		return VM_FAULT_OOM;
+	huge_addr = addr;
+	
+	/* Allocate our own private page. */
+	huge_pte_unmap(page_table);
+	spin_unlock(&mm->page_table_lock);
+
+	if (unlikely(anon_vma_prepare(vma)))
+		goto no_mem;
+	huge_page = alloc_huge_page_vma(GFP_HIGHUSER | __GFP_NOWARN, vma, addr);
+	if (!huge_page)
+		goto no_mem;
+	page = huge_page;
+	for(i=HUGE_PAGE_SIZE/PAGE_SIZE; i>0; i--) {
+		clear_user_highpage(page, addr);
+
+		page ++;
+		addr += PAGE_SIZE;
+	}
+
+	addr = huge_addr;
+	page = huge_page;
+	spin_lock(&mm->page_table_lock);
+	for(i=HUGE_PAGE_SIZE/PAGE_SIZE; i>0; i--) {
+		if (!pte_none(*page_table)) {
+			pte_unmap(page_table);
+			put_huge_page(huge_page);
+			spin_unlock(&mm->page_table_lock);
+			return VM_FAULT_MINOR;
+		}
+
+		inc_mm_counter(mm, rss);
+		entry = pte_mkhuge(maybe_mkwrite(pte_mkdirty(mk_pte(page, vma->vm_page_prot)), 
+			vma));
+		SetPageReferenced(page);
+		page_add_anon_rmap(page, vma, addr);
+		set_pte_at(mm, addr, page_table, entry);
+		pte_unmap(page_table);
+		update_mmu_cache(vma, addr, entry);
+		lazy_mmu_prot_update(entry);
+
+		addr += PAGE_SIZE;
+		page ++;
+		page_table ++;
+	}
+	spin_unlock(&mm->page_table_lock);
+	return VM_FAULT_MINOR;
+no_mem:
+	HUGE_PAGE_DEBUG_EX(("Error: no_mem on do_anonymous_huge_page\n"))
+	return VM_FAULT_OOM;
+}
